@model thanhthao.Models.Category
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Category</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.CategoryId</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.CategoryName</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>
</div>

<h5>Products in this category (@(Model.Products?.Count ?? 0))</h5>
@if (Model.Products != null && Model.Products.Any())
{
    <table class="table">
        <thead>
            <tr><th>Id</th><th>Name</th><th>Price</th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Products)
            {
                <tr>
                    <td>@p.ProductId</td>
                    <td>@p.ProductName</td>
                    <td>@p.ProductPrice.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p><em>No products yet.</em></p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.CategoryId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
